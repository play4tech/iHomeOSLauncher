<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glass_customize_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ios_settings_bg"
    android:fitsSystemWindows="true">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ios_back_chevron"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/nav_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Customize Glass Effect"
            android:textColor="@color/onboarding_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Save Button -->
        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="Save"
            android:textColor="@color/ios_icon_blue"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- LIVE DOCK PREVIEW (PINNED) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="6dp"
            android:text="LIVE DOCK PREVIEW"
            android:textColor="@color/ios_settings_section_title"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Preview Card Container -->
        <FrameLayout
            android:id="@+id/preview_card_container"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_ios_preview_card"
            android:clipToOutline="true">

            <!-- Wallpaper Backdrop -->
            <ImageView
                android:id="@+id/preview_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Wallpaper Preview" />

            <!-- Floating Dock Glass Panel -->
            <FrameLayout
                android:id="@+id/preview_dock_wrapper"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp">

                <!-- The Liquid Glass Panel -->
                <foundation.e.bliss.glass.PreviewDockGlassView
                    android:id="@+id/preview_dock_glass"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Dock App Icons Row -->
                <LinearLayout
                    android:id="@+id/preview_dock_icons"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Phone Icon -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/icon_phone"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_preview_phone" />
                    </FrameLayout>

                    <!-- Messages Icon -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/icon_messages"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_preview_messages" />
                    </FrameLayout>

                    <!-- Browser Icon -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/icon_browser"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_preview_browser" />
                    </FrameLayout>

                    <!-- Camera Icon -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/icon_camera"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_preview_camera" />
                    </FrameLayout>

                </LinearLayout>
            </FrameLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- SCROLLABLE PARAMETERS LIST -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="48dp">

            <!-- SECTION 1: LENS OPTICS & REFRACTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:text="LENS OPTICS &amp; REFRACTION"
                android:textColor="@color/ios_settings_section_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/slider_refraction_height"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_bevel_width"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_refraction_falloff"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_displacement_scale"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_edge_softness"
                    layout="@layout/item_glass_slider" />

            </LinearLayout>

            <!-- SECTION 2: OPTICAL BLUR & COLOR DYNAMICS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="OPTICAL BLUR &amp; COLOR DYNAMICS"
                android:textColor="@color/ios_settings_section_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/slider_blur_amount"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_saturation"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_dispersion_strength"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_aberration_intensity"
                    layout="@layout/item_glass_slider" />

            </LinearLayout>

            <!-- SECTION 3: SPECULAR HIGHLIGHT & PHYSICS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="SPECULAR HIGHLIGHT &amp; PHYSICS"
                android:textColor="@color/ios_settings_section_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/slider_edge_highlight_width"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_edge_highlight_opacity"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_elasticity"
                    layout="@layout/item_glass_slider" />

            </LinearLayout>

            <!-- SECTION 4: ADVANCED OPTICS TOGGLES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="ADVANCED OPTICS TOGGLES"
                android:textColor="@color/ios_settings_section_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/switch_edge_highlight"
                    layout="@layout/item_glass_switch" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/switch_sensor_highlight"
                    layout="@layout/item_glass_switch" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/switch_adaptive_tint"
                    layout="@layout/item_glass_switch" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/switch_refraction_outward"
                    layout="@layout/item_glass_switch" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/switch_refraction_no_fold"
                    layout="@layout/item_glass_switch" />

            </LinearLayout>

            <!-- SECTION 5: RESET -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="DEFAULTS"
                android:textColor="@color/ios_settings_section_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btn_reset_defaults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset to Default Glass Settings"
                    android:textColor="@color/ios_icon_red"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
