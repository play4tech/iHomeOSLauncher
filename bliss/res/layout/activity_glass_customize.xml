<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glass_customize_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ios_settings_bg"
    android:fitsSystemWindows="true">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ios_back_chevron"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/nav_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Customize Glass Effect"
            android:textColor="@color/onboarding_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Save Button with Pro Badge -->
        <LinearLayout
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txt_btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="@color/ios_icon_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badge_save_pro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="PRO"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/ios_icon_blue"
                android:background="@drawable/bg_ios_badge_pro"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- LIVE DOCK PREVIEW (PINNED) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="6dp"
            android:text="LIVE GLASS PREVIEW (DOCK, FOLDER &amp; SEARCH)"
            android:textColor="@color/ios_settings_section_title"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Preview Card Container -->
        <FrameLayout
            android:id="@+id/preview_card_container"
            android:layout_width="match_parent"
            android:layout_height="204dp"
            android:background="@drawable/bg_ios_preview_card"
            android:clipToOutline="true">

            <!-- Wallpaper Backdrop -->
            <foundation.e.bliss.glass.PreviewWallpaperView
                android:id="@+id/preview_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Wallpaper Preview" />

            <!-- Desktop Items Row (3 Apps + 1 Glass Folder) -->
            <LinearLayout
                android:id="@+id/preview_desktop_row"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="top"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <!-- Desktop App 1 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <foundation.e.bliss.glass.SquircleImageView
                        android:id="@+id/icon_desktop_1"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_preview_photos" />
                </FrameLayout>

                <!-- Desktop App 2 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <foundation.e.bliss.glass.SquircleImageView
                        android:id="@+id/icon_desktop_2"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_preview_maps" />
                </FrameLayout>

                <!-- Desktop App 3 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <foundation.e.bliss.glass.SquircleImageView
                        android:id="@+id/icon_desktop_3"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_preview_settings" />
                </FrameLayout>

                <!-- Column 4: Glass Folder Preview -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <FrameLayout
                        android:id="@+id/preview_folder_container"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center">

                        <foundation.e.bliss.glass.FolderGlassView
                            android:id="@+id/preview_folder_glass"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Centered 2x2 cluster inside folder -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center">

                                <foundation.e.bliss.glass.SquircleImageView
                                    android:id="@+id/folder_mini_1"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_preview_phone" />

                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="1dp" />

                                <foundation.e.bliss.glass.SquircleImageView
                                    android:id="@+id/folder_mini_2"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_preview_messages" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal"
                                android:gravity="center">

                                <foundation.e.bliss.glass.SquircleImageView
                                    android:id="@+id/folder_mini_3"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_preview_browser" />

                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="1dp" />

                                <foundation.e.bliss.glass.SquircleImageView
                                    android:id="@+id/folder_mini_4"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_preview_camera" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Search Pill Preview (Centered Horizontally Above Dock) -->
            <FrameLayout
                android:id="@+id/preview_search_pill_container"
                android:layout_width="80dp"
                android:layout_height="26dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="80dp">

                <foundation.e.bliss.glass.SearchPillGlassView
                    android:id="@+id/preview_search_glass"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/preview_search_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Search"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />
            </FrameLayout>

            <!-- Floating Dock Glass Panel -->
            <FrameLayout
                android:id="@+id/preview_dock_wrapper"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp">

                <!-- The Glass Panel -->
                <foundation.e.bliss.glass.PreviewDockGlassView
                    android:id="@+id/preview_dock_glass"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Dock App Icons Row -->
                <LinearLayout
                    android:id="@+id/preview_dock_icons"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Phone Icon -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <foundation.e.bliss.glass.SquircleImageView
                            android:id="@+id/icon_phone"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_preview_phone" />
                    </FrameLayout>

                    <!-- Messages Icon -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <foundation.e.bliss.glass.SquircleImageView
                            android:id="@+id/icon_messages"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_preview_messages" />
                    </FrameLayout>

                    <!-- Browser Icon -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <foundation.e.bliss.glass.SquircleImageView
                            android:id="@+id/icon_browser"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_preview_browser" />
                    </FrameLayout>

                    <!-- Camera Icon -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <foundation.e.bliss.glass.SquircleImageView
                            android:id="@+id/icon_camera"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_preview_camera" />
                    </FrameLayout>

                </LinearLayout>
            </FrameLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- SCROLLABLE PARAMETERS LIST -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="48dp">

            <!-- SECTION 1: LENS OPTICS & REFRACTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:text="LENS OPTICS &amp; REFRACTION"
                android:textColor="@color/ios_settings_section_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/slider_refraction_height"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_bevel_width"
                    layout="@layout/item_glass_slider" />

            </LinearLayout>

            <!-- SECTION 2: OPTICAL BLUR & COLOR DYNAMICS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="OPTICAL BLUR &amp; COLOR DYNAMICS"
                android:textColor="@color/ios_settings_section_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/slider_blur_amount"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_white_tint_opacity"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_saturation"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_dispersion_strength"
                    layout="@layout/item_glass_slider" />

            </LinearLayout>

            <!-- SECTION 3: SPECULAR HIGHLIGHT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="SPECULAR HIGHLIGHT"
                android:textColor="@color/ios_settings_section_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/slider_edge_highlight_width"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_edge_highlight_opacity"
                    layout="@layout/item_glass_slider" />

            </LinearLayout>

            <!-- SECTION 4: BLACK OUTLINE BORDER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="BLACK OUTLINE BORDER"
                android:textColor="@color/ios_settings_section_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/switch_border_enabled"
                    layout="@layout/item_glass_switch" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_border_width"
                    layout="@layout/item_glass_slider" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/slider_border_opacity"
                    layout="@layout/item_glass_slider" />

            </LinearLayout>

            <!-- SECTION 5: ADVANCED OPTICS TOGGLES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="ADVANCED OPTICS TOGGLES"
                android:textColor="@color/ios_settings_section_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/switch_edge_highlight"
                    layout="@layout/item_glass_switch" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/switch_sensor_highlight"
                    layout="@layout/item_glass_switch" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/switch_adaptive_tint"
                    layout="@layout/item_glass_switch" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/switch_refraction_outward"
                    layout="@layout/item_glass_switch" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_settings_card_divider" />

                <include
                    android:id="@+id/switch_refraction_no_fold"
                    layout="@layout/item_glass_switch" />

            </LinearLayout>

            <!-- SECTION 5: RESET -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="DEFAULTS"
                android:textColor="@color/ios_settings_section_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btn_reset_defaults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset to Default Glass Settings"
                    android:textColor="@color/ios_icon_red"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- AdMob Banner Container (Strictly pinned at bottom, isolated from sliders, hidden for Pro) -->
    <FrameLayout
        android:id="@+id/ad_banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@color/ios_settings_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone" />

</LinearLayout>
