<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_app_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- App Icon -->
        <foundation.e.bliss.glass.SquircleImageView
            android:id="@+id/img_app_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="fitCenter"
            android:contentDescription="App Icon" />

        <!-- App Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/onboarding_text_primary"
                android:textSize="16sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txt_app_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/onboarding_text_secondary"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- iOS Switch -->
        <Switch
            android:id="@+id/switch_app_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:switchMinWidth="51dp"
            android:track="@drawable/ios_switch_track"
            android:thumb="@drawable/ios_switch_thumb"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <!-- Row Divider -->
    <View
        android:id="@+id/divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="68dp"
        android:background="@color/ios_settings_card_divider" />
</LinearLayout>
