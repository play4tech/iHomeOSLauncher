<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_ios_settings_card"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <!-- Icon Container -->
    <FrameLayout
        android:id="@+id/frame_dialog_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_ios_icon_container"
        android:backgroundTint="@color/ios_icon_blue">
        <ImageView
            android:id="@+id/img_dialog_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_apps" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txt_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Unlock Setting"
        android:textColor="@color/onboarding_text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Message -->
    <TextView
        android:id="@+id/txt_dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="Watch a short ad to unlock this setting, or upgrade to Pro for an ad-free experience."
        android:textColor="@color/onboarding_text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:gravity="center" />

    <!-- Watch Ad Button -->
    <TextView
        android:id="@+id/btn_dialog_watch_ad"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_ios_capsule_button"
        android:backgroundTint="@color/ios_icon_blue"
        android:gravity="center"
        android:text="Watch Ad to Unlock"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Upgrade to Pro Button -->
    <TextView
        android:id="@+id/btn_dialog_upgrade_pro"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_ios_capsule_button_secondary"
        android:gravity="center"
        android:text="Upgrade to Pro"
        android:textColor="@color/ios_icon_blue"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Cancel Button -->
    <TextView
        android:id="@+id/btn_dialog_cancel"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:text="Cancel"
        android:textColor="@color/onboarding_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
