<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="WidgetTitle" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/widgetPrimaryTextColor</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="SearchBar">
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:colorControlActivated">@color/colorAccent</item>
    </style>

    <style name="Theme.Bliss.Onboarding" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/onboarding_bg</item>
        <item name="android:statusBarColor">@color/onboarding_bg</item>
        <item name="android:navigationBarColor">@color/onboarding_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
