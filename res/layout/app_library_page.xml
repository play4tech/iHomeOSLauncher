<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_library_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Content Container (Search Bar + Dashboard) -->
    <LinearLayout
        android:id="@+id/app_library_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="36dp">

        <!-- Search Bar Container -->
        <FrameLayout
            android:id="@+id/app_library_search_container"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <com.android.launcher3.applibrary.view.AppLibrarySearchGlassView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_allapps_search"
                    android:tint="#8E8E93" />

                <EditText
                    android:id="@+id/app_library_search_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="App Library"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8E8E93"
                    android:textSize="17sp"
                    android:paddingStart="8dp"
                    android:gravity="center_vertical"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text|textNoSuggestions"
                    android:singleLine="true" />
            </LinearLayout>
        </FrameLayout>

        <!-- Dashboard View (Staggered Grid) -->
        <com.android.launcher3.applibrary.view.AppLibraryDashboardView
            android:id="@+id/app_library_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <!-- Search Results View (A-Z List view, initially GONE) -->
    <com.android.launcher3.allapps.AllAppsRecyclerView
        android:id="@+id/app_library_search_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="90dp"
        android:visibility="gone"
        android:background="#E0000000" />

    <!-- Category Expansion Overlay Layer (initially GONE) -->
    <FrameLayout
        android:id="@+id/app_library_expansion_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#CC000000"
        android:clipChildren="false"
        android:clipToPadding="false" />

</FrameLayout>
