<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_library_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- App Library Search Backdrop Layer (frosted glass + dark scrim) -->
    <FrameLayout
        android:id="@+id/app_library_search_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.android.launcher3.applibrary.view.AppLibraryOverlayGlassView
            android:id="@+id/app_library_search_backdrop_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Content Container (Search Bar + Dashboard / Search Results) -->
    <LinearLayout
        android:id="@+id/app_library_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="36dp">

        <!-- Search Bar Row (Search Bar + Cancel Button) -->
        <LinearLayout
            android:id="@+id/app_library_search_row"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:elevation="4dp"
            android:translationZ="4dp">

            <FrameLayout
                android:id="@+id/app_library_search_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <com.android.launcher3.applibrary.view.AppLibrarySearchGlassView
                    android:id="@+id/app_library_search_glass"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_allapps_search"
                        android:tint="#FFFFFF" />

                    <EditText
                        android:id="@+id/app_library_search_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="App Library"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#99FFFFFF"
                        android:textSize="17sp"
                        android:paddingStart="8dp"
                        android:gravity="center_vertical"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:inputType="text|textNoSuggestions"
                        android:singleLine="true" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/app_library_search_cancel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:fontFamily="sans-serif"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Dashboard View (Staggered Grid) -->
        <com.android.launcher3.applibrary.view.AppLibraryDashboardView
            android:id="@+id/app_library_dashboard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:clipToPadding="false"
            android:paddingBottom="48dp" />

        <!-- Search Results Container (A-Z List + Alphabet Scroller) -->
        <FrameLayout
            android:id="@+id/app_library_search_results_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/app_library_search_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="48dp"
                android:scrollbars="none" />

            <com.android.launcher3.applibrary.view.AppLibraryIndexScrollerView
                android:id="@+id/app_library_index_scroller"
                android:layout_width="18dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="2dp" />
        </FrameLayout>

    </LinearLayout>

    <!-- Category Expansion Overlay Layer (initially GONE) -->
    <FrameLayout
        android:id="@+id/app_library_expansion_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#CC000000"
        android:clipChildren="false"
        android:clipToPadding="false" />

</FrameLayout>
