<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.applibrary.view.AppLibraryCategoryExpandedView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fitsSystemWindows="false">

        <!-- Full screen glass background is not used in iOS App Library expansion (wallpaper blur persists seamlessly) -->
        <View
            android:id="@+id/app_library_overlay_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:fitsSystemWindows="false" />

        <!-- Content overlay — centered on screen like iOS folder/overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingTop="60dp"
            android:paddingBottom="60dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fitsSystemWindows="false">

            <!-- Category Title -->
            <TextView
                android:id="@+id/expanded_category_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingBottom="24dp"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Grid of apps -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/expanded_category_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false" />

        </LinearLayout>
    </FrameLayout>
</com.android.launcher3.applibrary.view.AppLibraryCategoryExpandedView>
